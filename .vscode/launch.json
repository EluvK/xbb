{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App",
      "request": "launch",
      "type": "dart",
      "cwd": "app",
      "program": "lib/main.dart"
    },
    {
      "name": "Server",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=server",
          "--package=server"
        ],
        "filter": {
          "name": "server",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}/server"
    }
  ]
}
