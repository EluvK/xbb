{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Rust Server",
      "type": "shell",
      "command": "cargo run --bin server",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Compiling|Finished|Running).*",
          "endsPattern": ".*Server listening on.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "server",
        "clear": false
      }
    },
    {
      "label": "Build Rust Server",
      "type": "shell",
      "command": "cargo build --bin server",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    }
  ]
}
